# Copy to .env on the server. Never commit .env.

# LINE Developers console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Primary LLM: Gemini via its OpenAI-compatible endpoint (https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Check current model IDs at https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-flash-latest

# Fallback LLM, used when the primary fails (e.g. 503 overloaded). Leave the key empty to disable.
# Default: Gemini Flash-Lite with the same key as above (separate capacity from Flash).
# Alternative: NVIDIA (https://build.nvidia.com), base URL https://integrate.api.nvidia.com/v1
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-flash-lite-latest

# Deployment
DOMAIN=yourname.duckdns.org
DUCKDNS_TOKEN=
# Set to a commit SHA to roll back, e.g. IMAGE_TAG=3f2a1bc...
IMAGE_TAG=latest

# Optional tuning (defaults shown)
# TIMEZONE=Asia/Taipei
# RETENTION_DAYS=7
# DEFAULT_WINDOW_HOURS=12
# COOLDOWN_SECONDS=60
# MAX_MESSAGES=2000
# MAX_INPUT_CHARS=60000
